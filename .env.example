# ───────────── Server-only secrets (set in Vercel → Settings → Environment Variables) ─────────────
# DrugSetu PRIVATE key (starts with ds_, not ds_pk_). Website keys are rejected server-side.
DRUGSETU_API_KEY=
# Optional overrides
# DRUGSETU_API_BASE_URL=https://api.drugsetu.com/v1
# DRUGSETU_PAGE_SIZE=5          # your plan's max page size for list endpoints

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Owner WhatsApp number — international format, digits only, no + or spaces (e.g. 971501234567)
WHATSAPP_OWNER_NUMBER=

# ───────────── Public business details (shown on the site; leave blank to hide) ─────────────
# Same number as above — used for footer/contact links
NEXT_PUBLIC_WHATSAPP_OWNER_NUMBER=
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_COMPANY_NAME=Pharmafitx
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
